APP_ENV=development
AI_PROVIDER=mock

# Supabase Dashboard -> Project -> Connect -> Session pooler (IPv4, port 5432).
# Copy YOUR host and username from the dashboard; do not guess the region/index.
# Percent-encode reserved characters in the password before pasting into a URL.
# Replace all example placeholders in your untracked backend/.env file.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require

# Optional: Direct connection for Alembic migrations if your PC supports IPv6.
# If omitted, migrations use DATABASE_URL (session pooler is suitable for local IPv4).
# MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:YOUR_URL_ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# SQLite alternative ONLY for isolated local development / tests (do not use for the shared demo):
# DATABASE_URL=sqlite:///./ai_diary.db

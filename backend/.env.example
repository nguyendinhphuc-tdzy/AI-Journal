APP_ENV=development
AI_PROVIDER=mock

# Optional local AI (requires Ollama installed on the FastAPI machine).
# Windows Phuc: OLLAMA_MODEL=qwen3:4b
# Mac Vy: OLLAMA_MODEL=qwen3.5:4b
# Set AI_PROVIDER=ollama to enable local inference. A valid Supabase JWT
# is required for HTTP AI endpoints in this mode.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=350

# Supabase Dashboard -> Project -> Connect -> Session pooler (IPv4, port 5432).
# Copy YOUR host and username from dashboard; percent-encode password.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require

# Optional direct Postgres connection for Alembic with IPv6:
# MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:YOUR_URL_ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Public project URL for JWT signature verification (NO API key necessary):
SUPABASE_URL=https://PROJECT_REF.supabase.co

# Supabase Auth MUST use ES256/RS256 signing keys for this verifier;
# legacy HS256 is deliberately rejected. Do not put JWT secret or
# service_role key in Flutter, frontend source, or Git.

# SQLite alternative ONLY for isolated local development / tests:
# DATABASE_URL=sqlite:///./ai_diary.db

# OPTIONAL: Geoapify text/address search for MapLibre Explore. Keep key on backend.
# Without this setting, saved manual map pins still work; /geo/search returns 503.
# GEOAPIFY_API_KEY=your_geoapify_key_here

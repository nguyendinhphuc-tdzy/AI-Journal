<?xml version="1.0" encoding="utf-8"?>
<!-- On Android 12+, exclude app-private files/preferences from both cloud
     backup and device-to-device restore. Guest data cannot be restored after
     uninstall/reinstall through Android's default extraction paths. -->
<data-extraction-rules xmlns:android="http://schemas.android.com/apk/res/android">
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
